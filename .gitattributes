# ============================================================
# Omnia — 换行与 diff 规则
# 原则：文本文件统一以 LF 入库并检出（与 .editorconfig 的
# end_of_line = lf 一致），二进制文件不参与文本 diff 与合并。
# ============================================================

# 默认交给 git 识别文本，且一律以 LF 检出，避免 Windows 工作区混入 CRLF
* text=auto eol=lf

# --- 源码与配置：显式声明，读起来不用猜 ---
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.mjs         text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.lock        text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# --- 脚本：保证在类 Unix 环境可直接执行 ---
*.sh          text eol=lf

# --- 二进制：不做文本 diff / 合并 ---
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.ico         binary
*.icns        binary
*.exe         binary
*.msi         binary
*.zip         binary
*.pdb         binary

# --- 生成的锁文件：折叠 diff，减少噪音 ---
pnpm-lock.yaml        linguist-generated=true
src-tauri/Cargo.lock  linguist-generated=true
